.page-title { font-size: 41rpx; }.search-box { background: #fff; border: 1rpx solid #e4eae7; border-radius: 18rpx; padding: 18rpx 24rpx; margin-top: 30rpx; display: flex; align-items: center; gap: 17rpx; }.search-box text { color: #82998a; font-size: 34rpx; }.search-box input { flex: 1; height: 50rpx; font-size: 26rpx; }.result-head { display: flex; justify-content: space-between; color: #97a19d; font-size: 22rpx; margin-bottom: 19rpx; }.guide-card { display: block; text-align: left; width: 100%; }.guide-arrow { color: #829b8c; font-size: 33rpx; }.guide-preview { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: #8b9690; font-size: 24rpx; line-height: 1.8; }.guide-meta { color: #a1aaa3; font-size: 21rpx; margin-top: 20rpx; }.guide-meta text { padding: 0 13rpx; }
