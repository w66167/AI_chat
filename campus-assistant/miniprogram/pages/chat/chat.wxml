<view class="chat">
  <view class="scope">
    <view class="scope-text"><text class="scope-role">{{roleName}}</text>可查：{{libraryNames || '—'}}<text wx:if="{{isGuest}}">（对话不保存）</text></view>
    <button class="scope-new" wx:if="{{messages.length}}" bindtap="clear">新对话</button>
    <button class="scope-new" wx:elif="{{isGuest}}" bindtap="openMine">绑定身份</button>
  </view>

  <scroll-view class="chat-scroll" scroll-y="{{true}}" scroll-into-view="{{scrollTarget}}" scroll-with-animation="{{true}}">
    <view class="chat-content">
      <view class="welcome" wx:if="{{!messages.length && !asking && !error}}">
        <view class="welcome-title">想了解哪条规定？</view>
        <view class="welcome-desc">直接用平常的话问。我会从手册里找到对应条文，说清楚规定是什么，并标出是哪一条、第几页。</view>
        <button class="starter" wx:for="{{starters}}" wx:key="*this" data-question="{{item}}" bindtap="askSuggestion">{{item}}</button>
      </view>

      <view wx:for="{{messages}}" wx:key="id" wx:for-item="message" class="message" id="msg-{{message.id}}">
        <view wx:if="{{message.speaker === 'user'}}" class="question"><text selectable="{{true}}">{{message.text}}</text></view>

        <view wx:else class="answer answer-{{message.kind}}">
          <view class="answer-kind" wx:if="{{message.kind !== 'answer'}}">{{message.kind === 'clarify' ? '需要再具体一点' : message.kind === 'boundary' ? '这件事我办不了' : '手册里没有找到依据'}}</view>
          <text class="answer-text {{message.folded && !expanded[message.id] ? 'folded' : ''}} {{message.mode === 'excerpt' ? 'excerpt' : ''}}" selectable="{{true}}">{{message.text}}</text>
          <view class="answer-more" wx:if="{{message.folded}}" data-id="{{message.id}}" bindtap="toggleExpand">{{expanded[message.id] ? '收起' : '展开全文'}}</view>

          <view class="sources" wx:if="{{message.citations.length}}">
            <view class="sources-label">{{message.mode === 'generated' ? '依据以下条文整理' : '手册原文出自'}}</view>
            <button class="slip" wx:for="{{message.citations}}" wx:key="chunkId" wx:for-item="cite" data-id="{{cite.chunkId}}" bindtap="openArticle">
              <view class="slip-main"><view class="slip-article">{{cite.article || '正文'}}</view><view class="slip-doc">《{{cite.doc}}》</view></view>
              <view class="slip-page" wx:if="{{cite.page}}">第 {{cite.page}} 页</view>
            </button>
          </view>

          <view class="answer-note" wx:if="{{message.note}}">{{message.note}}</view>
          <view class="answer-note" wx:if="{{message.degraded}}">生成服务暂时不可用，这次直接给出了条文原文。</view>

          <view class="followups" wx:if="{{message.suggestions.length}}">
            <button class="followup" wx:for="{{message.suggestions}}" wx:key="*this" wx:for-item="suggestion" data-question="{{suggestion}}" bindtap="askSuggestion">{{suggestion}}</button>
          </view>

          <view class="feedback" wx:if="{{message.kind === 'answer' || message.kind === 'none'}}">
            <button class="feedback-button {{message.feedback === 'resolved' ? 'on' : ''}}" data-id="{{message.id}}" data-value="resolved" bindtap="feedback">有帮助</button>
            <button class="feedback-button {{message.feedback === 'unresolved' ? 'on' : ''}}" data-id="{{message.id}}" data-value="unresolved" bindtap="feedback">没解决</button>
          </view>
        </view>
      </view>

      <view class="message" id="asking" wx:if="{{asking}}">
        <view class="question"><text>{{asking}}</text></view>
        <view class="answer thinking">正在查手册<text class="dot">.</text><text class="dot dot-2">.</text><text class="dot dot-3">.</text></view>
      </view>

      <view class="message" id="error" wx:if="{{error}}">
        <view class="question"><text>{{failedQuestion}}</text></view>
        <view class="answer answer-failed">
          <view class="answer-kind">这次没有问成功</view>
          <view class="answer-text">{{error}}</view>
          <button class="btn btn-ghost retry" bindtap="retry">重新提问</button>
        </view>
      </view>
      <view class="chat-end"></view>
    </view>
  </scroll-view>

  <view class="composer">
    <view class="composer-row">
      <input class="composer-input" value="{{input}}" placeholder="问一条规定…" maxlength="300" confirm-type="send" bindinput="inputChange" bindconfirm="send" adjust-position="{{true}}"/>
      <button class="composer-send" disabled="{{busy || !input}}" bindtap="send">发送</button>
    </view>
    <view class="composer-hint">不查个人成绩、不代办业务；请勿输入密码或证件号。</view>
  </view>
</view>
