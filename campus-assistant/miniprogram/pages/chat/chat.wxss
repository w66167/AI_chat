page { height: 100%; }
.chat { height: 100%; display: flex; flex-direction: column; background: var(--bg); }

/* ---------- 顶栏 ---------- */
.topbar {
  flex: none; padding: 18rpx 28rpx;
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-bottom: 1rpx solid var(--line);
}
.topbar-left { display: flex; align-items: center; gap: 14rpx; }
.topbar-title { font-size: 30rpx; font-weight: 650; }
.badge {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 20rpx; color: var(--muted);
  background: #f1f3f7; padding: 5rpx 14rpx; border-radius: 100rpx;
}
.badge-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #b6bdc9; }
.badge.on { background: #eaf1ff; color: var(--primary-ink); }
.badge.on .badge-dot { background: var(--primary); }
.ghost-btn { font-size: 24rpx; color: var(--muted); padding: 8rpx 4rpx; }

/* ---------- 会话区 ---------- */
.thread { flex: 1; min-height: 0; }
.thread-inner { padding: 24rpx 28rpx 8rpx; }
.thread-end { height: 8rpx; }

.welcome { padding: 56rpx 8rpx 24rpx; display: flex; flex-direction: column; align-items: flex-start; }
.welcome-mark {
  width: 88rpx; height: 88rpx; border-radius: 26rpx;
  background: var(--primary); color: #fff;
  font-size: 38rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx;
}
.welcome-title { font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; }
.welcome-desc { font-size: 25rpx; color: var(--muted); margin: 10rpx 0 28rpx; }
.starters { display: flex; flex-wrap: wrap; }

/* ---------- 消息 ---------- */
.msg { margin-bottom: 24rpx; display: flex; flex-direction: column; }
.msg.user { align-items: flex-end; }
.msg.assistant { align-items: flex-start; }

.bubble {
  max-width: 78%; padding: 20rpx 24rpx; border-radius: 22rpx;
  font-size: 28rpx; line-height: 1.6; word-break: break-word;
}
.user-bubble { background: var(--primary); color: #fff; border-bottom-right-radius: 8rpx; }

.answer-card {
  width: 100%; background: #fff; border: 1rpx solid var(--line);
  border-radius: 22rpx; padding: 24rpx;
}
.answer-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.answer-kind {
  font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx;
  background: var(--primary-soft); color: var(--primary-ink);
}
.answer-kind.clarify { background: #fff6e8; color: var(--amber); }
.answer-kind.fallback { background: #f1f3f7; color: var(--muted); }
.answer-time { font-size: 20rpx; color: #b0b6c3; }

.answer-body {
  font-size: 27rpx; line-height: 1.8; color: #22262f;
  white-space: pre-wrap; word-break: break-word;
}
.answer-body.clamped {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 6;
  overflow: hidden;
}
.expand { font-size: 24rpx; color: var(--primary); margin-top: 10rpx; }

/* ---------- 出处 ---------- */
.cites { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.cites-head { font-size: 21rpx; color: var(--muted); letter-spacing: 1rpx; margin-bottom: 10rpx; }
.cite { display: flex; flex-direction: column; gap: 2rpx; padding: 10rpx 0; }
.cite-doc { font-size: 25rpx; color: #2c3340; }
.cite-meta { font-size: 22rpx; color: var(--muted); }

.channel {
  margin-top: 16rpx; padding: 16rpx 18rpx;
  background: #f6f7fa; border-radius: 14rpx;
  font-size: 23rpx; color: var(--muted); line-height: 1.6;
}

/* ---------- 底部反馈 ---------- */
.answer-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.foot-hint { font-size: 20rpx; color: #b0b6c3; }
.feedback { display: flex; gap: 12rpx; }
.fb {
  font-size: 22rpx; color: var(--muted); padding: 8rpx 18rpx;
  border: 1rpx solid var(--line); border-radius: 100rpx; background: #fff;
}
.fb.on { color: var(--primary-ink); border-color: #cfdefe; background: var(--primary-soft); }

.suggestions { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.suggestions .chip { font-size: 23rpx; padding: 10rpx 20rpx; }

/* ---------- 加载态 ---------- */
.answer-card.typing { display: flex; align-items: center; gap: 16rpx; }
.dot-loading { display: flex; gap: 8rpx; }
.ld {
  width: 12rpx; height: 12rpx; border-radius: 50%; background: #c4cbdb;
  animation: bounce 1.1s infinite ease-in-out;
}
.ld:nth-child(2) { animation-delay: .16s; }
.ld:nth-child(3) { animation-delay: .32s; }
@keyframes bounce { 0%, 80%, 100% { transform: scale(.7); opacity: .5; } 40% { transform: scale(1); opacity: 1; } }
.typing-text { font-size: 25rpx; color: var(--muted); }

/* ---------- 输入区 ---------- */
.composer {
  flex: none; padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid var(--line);
}
.input-row {
  display: flex; align-items: center; gap: 12rpx;
  background: #f6f7fa; border-radius: 100rpx; padding: 8rpx 8rpx 8rpx 26rpx;
}
.input { flex: 1; height: 66rpx; font-size: 27rpx; }
.send {
  width: 104rpx; height: 62rpx; line-height: 62rpx; flex: none;
  border-radius: 100rpx; background: var(--primary); color: #fff;
  font-size: 25rpx; font-weight: 600; text-align: center;
}
.composer-note { display: block; margin-top: 12rpx; font-size: 20rpx; color: #a3aab8; text-align: center; }
