page { height: 100%; }
.chat-shell { height: 100%; display: flex; flex-direction: column; }
.chat-top { padding: 22rpx 30rpx; border-bottom: 1rpx solid #e5ebea; display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; background: #f5f7fa; }
.assistant-name { font-size: 30rpx; font-weight: 650; display: block; }.assistant-status { font-size: 20rpx; color: #7f9288; }.new-chat { font-size: 23rpx; color: #176b5b; background: #e9f1ed; padding: 12rpx 20rpx; border-radius: 100rpx; }
.chat-scroll { flex: 1; min-height: 0; height: 0; }.chat-content { padding: 28rpx; }
.welcome { padding: 38rpx 12rpx 20rpx; }.welcome-logo { background: #176b5b; color: #e7f1c2; width: 90rpx; height: 90rpx; text-align: center; line-height: 90rpx; border-radius: 27rpx; font-size: 43rpx; font-weight: 600; margin-bottom: 28rpx; }
.welcome-title { font-size: 36rpx; font-weight: 650; }.welcome-desc { color: #7b8b85; font-size: 25rpx; margin: 16rpx 0 34rpx; line-height: 1.9; }
.starter { background: #fff; border: 1rpx solid #e1e9e6; margin-bottom: 15rpx; padding: 22rpx 25rpx; font-size: 25rpx; display: flex; justify-content: space-between; text-align: left; }
.message { margin-bottom: 30rpx; }.message.user { display: flex; justify-content: flex-end; }.user-bubble { max-width: 88%; background: #176b5b; color: #fff; padding: 22rpx 27rpx; border-radius: 22rpx 22rpx 5rpx 22rpx; white-space: pre-wrap; word-break: break-all; }
.answer-label { display: flex; align-items: center; gap: 11rpx; font-size: 23rpx; margin-bottom: 14rpx; font-weight: 600; }.mini-avatar { width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 12rpx; background: #dfece4; text-align: center; color: #176b5b; font-size: 23rpx; }.answer-kind { color: #96a29c; font-size: 20rpx; font-weight: 400; margin-left: auto; }
.answer-bubble { padding: 26rpx; background: #fff; border-radius: 5rpx 22rpx 22rpx 22rpx; border: 1rpx solid #e6ece9; }.answer-text { font-size: 27rpx; line-height: 1.9; white-space: pre-wrap; word-break: break-all; }.context-hint { color: #719183; font-size: 22rpx; margin-bottom: 15rpx; }
.answer-steps { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #eef1ef; }.step { display: flex; gap: 17rpx; font-size: 24rpx; margin-bottom: 16rpx; color: #586d63; }.step-number { background: #edf4ef; color: #5d836d; width: 35rpx; min-width: 35rpx; height: 35rpx; line-height: 35rpx; font-size: 20rpx; border-radius: 50%; text-align: center; margin-top: 4rpx; }
.channel { background: #f6f8f5; border-radius: 13rpx; padding: 19rpx; font-size: 23rpx; margin-top: 19rpx; color: #63776a; white-space: pre-wrap; }.channel-label { display: block; font-size: 20rpx; color: #96a293; margin-bottom: 4rpx; }
.source-card { margin-top: 22rpx; text-align: left; border: 1rpx solid #dfebe4; padding: 19rpx; border-radius: 14rpx; color: #527b64; font-size: 22rpx; }.source-title { display: flex; justify-content: space-between; color: #93a194; font-size: 20rpx; margin-bottom: 9rpx; }.source-meta { font-size: 18rpx; color: #8e9f93; margin-top: 8rpx; }.answer-demo { margin-top: 17rpx; font-size: 19rpx; color: #a3a99d; }
.feedback { display: flex; gap: 17rpx; align-items: center; color: #9ba59f; font-size: 20rpx; margin-top: 13rpx; }.feedback button { font-size: 20rpx; color: #8b9991; padding: 7rpx 15rpx; }.feedback button.selected { color: #176b5b; background: #e1eee6; border-radius: 100rpx; }
.suggestions { margin-top: 15rpx; }.suggestions button { text-align: left; background: #edf3ef; color: #567e66; padding: 15rpx 22rpx; font-size: 23rpx; margin-bottom: 10rpx; }
.composer { flex-shrink: 0; padding: 18rpx 25rpx 16rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e6ece9; }.input-row { display: flex; align-items: center; padding: 12rpx; background: #f1f5f2; border-radius: 22rpx; gap: 12rpx; }.input-row input { flex: 1; min-width: 0; padding: 0 12rpx; height: 65rpx; font-size: 26rpx; }.send-button { background: #176b5b; color: #fff; padding: 14rpx 22rpx; font-size: 25rpx; border-radius: 15rpx; }.composer-hint { font-size: 18rpx; color: #9aa69f; text-align: center; margin-top: 13rpx; }.scroll-end { height: 20rpx; }
