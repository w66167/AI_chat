page { height: 100%; }
.chat { height: 100%; display: flex; flex-direction: column; }

.scope { flex-shrink: 0; display: flex; align-items: center; gap: 20rpx; padding: 16rpx 32rpx; border-bottom: 1rpx solid var(--line); font-size: 23rpx; color: var(--ink-2); }
.scope-text { flex: 1; min-width: 0; }
.scope-role { color: var(--green); font-weight: 600; margin-right: 14rpx; }
.scope-new { color: var(--green); font-size: 24rpx; padding: 8rpx 0 8rpx 16rpx; flex-shrink: 0; }

.chat-scroll { flex: 1; min-height: 0; height: 0; }
.chat-content { padding: 32rpx; }
.chat-end { height: 24rpx; }

.welcome { padding: 40rpx 0 8rpx; }
.welcome-title { font-family: var(--serif); font-size: 44rpx; font-weight: 700; }
.welcome-desc { color: var(--ink-2); font-size: 26rpx; line-height: 1.8; margin: 16rpx 0 36rpx; }
.starter { background: var(--card); border-radius: 16rpx; padding: 24rpx 28rpx; margin-bottom: 14rpx; font-size: 27rpx; }

.message { margin-bottom: 36rpx; }
.question { margin-left: 15%; display: flex; justify-content: flex-end; }
.question text { background: var(--green); color: #fff; padding: 20rpx 26rpx; border-radius: 22rpx 22rpx 6rpx 22rpx; font-size: 28rpx; word-break: break-all; }

.answer { margin-top: 20rpx; background: var(--card); border-radius: 6rpx 22rpx 22rpx 22rpx; padding: 28rpx; }
.answer-kind { font-size: 23rpx; font-weight: 600; color: var(--warn-ink); margin-bottom: 10rpx; }
.answer-text { display: block; font-size: 29rpx; line-height: 1.85; white-space: pre-wrap; word-break: break-all; }
.answer-text.excerpt { font-family: var(--serif); }
.answer-text.folded { display: -webkit-box; -webkit-line-clamp: 7; -webkit-box-orient: vertical; overflow: hidden; }
.answer-more { color: var(--green); font-size: 25rpx; margin-top: 12rpx; padding: 4rpx 0; }

.sources { margin-top: 28rpx; }
.sources-label { font-size: 22rpx; color: var(--ink-3); margin-bottom: 12rpx; }
.sources .slip { background: var(--paper); }

.answer-note { margin-top: 20rpx; font-size: 23rpx; color: var(--ink-2); line-height: 1.7; }

.followups { margin-top: 24rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.followup { background: var(--green-soft); color: var(--green); padding: 12rpx 22rpx; border-radius: 100rpx; font-size: 24rpx; }

.feedback { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); display: flex; gap: 12rpx; }
.feedback-button { font-size: 23rpx; color: var(--ink-3); padding: 8rpx 22rpx; border-radius: 100rpx; border: 1rpx solid var(--line); }
.feedback-button.on { color: var(--green); border-color: var(--green); background: var(--green-soft); }

.thinking { color: var(--ink-2); font-size: 26rpx; }
.dot { animation: blink 1.2s infinite; }
.dot-2 { animation-delay: .2s; }
.dot-3 { animation-delay: .4s; }
@keyframes blink { 0%, 60%, 100% { opacity: .2; } 30% { opacity: 1; } }

.answer-failed .answer-text { font-size: 26rpx; color: var(--ink-2); }
.retry { display: inline-block; margin-top: 20rpx; padding: 14rpx 36rpx; font-size: 25rpx; }

.composer { flex-shrink: 0; background: var(--card); border-top: 1rpx solid var(--line); padding: 18rpx 24rpx; padding-bottom: calc(18rpx + env(safe-area-inset-bottom)); }
.composer-row { display: flex; align-items: center; gap: 14rpx; background: var(--paper); border-radius: 18rpx; padding: 8rpx 8rpx 8rpx 24rpx; }
.composer-input { flex: 1; min-width: 0; height: 72rpx; font-size: 28rpx; }
.composer-send { background: var(--green); color: #fff; padding: 14rpx 30rpx; border-radius: 12rpx; font-size: 26rpx; font-weight: 600; }
.composer-hint { font-size: 20rpx; color: var(--ink-3); text-align: center; margin-top: 12rpx; }
