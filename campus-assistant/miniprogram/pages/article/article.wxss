/* 条文原文页是整个小程序里唯一「像纸」的地方：宋体、朱红条号、加大行距。 */
.article-doc { font-size: 25rpx; color: var(--green); padding: 4rpx 0; }
.article-chapter { font-size: 24rpx; color: var(--ink-2); margin-top: 8rpx; }

.article-body { margin-top: 32rpx; background: var(--card); border-left: 8rpx solid var(--seal); padding: 40rpx 36rpx 44rpx 32rpx; }
.article-number { font-family: var(--serif); font-size: 46rpx; font-weight: 700; color: var(--seal); line-height: 1.3; margin-bottom: 24rpx; }
.article-text { display: block; font-family: var(--serif); font-size: 32rpx; line-height: 2.05; white-space: pre-wrap; word-break: break-all; text-align: justify; }

.article-meta { margin-top: 28rpx; font-size: 23rpx; color: var(--ink-3); line-height: 1.9; }

.article-actions { display: flex; gap: 16rpx; margin-top: 36rpx; }
.article-actions .btn { flex: 1; }

.article-turn { display: flex; gap: 16rpx; margin-top: 44rpx; padding-top: 32rpx; border-top: 1rpx solid var(--line); }
.turn { flex: 1; padding: 8rpx 0; }
.turn-next { text-align: right; }
.turn-label { font-size: 22rpx; color: var(--ink-3); }
.turn-name { font-family: var(--serif); font-size: 28rpx; font-weight: 700; color: var(--ink); margin-top: 2rpx; }
