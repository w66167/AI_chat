.me { display: flex; align-items: center; gap: 24rpx; margin-top: 8rpx; }
.page .notice + .me { margin-top: 32rpx; }
.me-avatar { width: 104rpx; height: 104rpx; line-height: 104rpx; text-align: center; border-radius: 50%; background: var(--green); color: #fff; font-family: var(--serif); font-size: 44rpx; font-weight: 700; flex-shrink: 0; }
.me-main { flex: 1; min-width: 0; }
.me-name { font-size: 38rpx; font-weight: 700; }
.me-desc { font-size: 24rpx; color: var(--ink-2); margin-top: 4rpx; }
.me-note { font-size: 22rpx; color: var(--ink-3); margin-top: 20rpx; line-height: 1.7; }

.code { margin-top: 16rpx; padding: 28rpx; }
.code-label { font-size: 24rpx; color: var(--ink-2); }
.code-input { height: 84rpx; margin-top: 16rpx; padding: 0 24rpx; background: var(--paper); border-radius: 12rpx; font-size: 28rpx; }
.code-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.code-actions .btn { flex: 1; }

.library { align-items: flex-start; }
.library-head { display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap; }
.library .row-desc { margin-top: 10rpx; line-height: 1.7; }
.sign-out { color: var(--seal); }
