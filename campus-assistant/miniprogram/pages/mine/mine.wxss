.identity { margin-top: 30rpx; display: flex; gap: 20rpx; align-items: center; }.avatar { width: 82rpx; height: 82rpx; line-height: 82rpx; background: #e2ede4; color: #4c7860; border-radius: 25rpx; text-align: center; font-size: 35rpx; font-weight: 600; flex-shrink: 0; }.identity-info { flex: 1; }.identity-name { font-weight: 650; font-size: 29rpx; }.identity-info .muted { font-size: 21rpx; margin: 5rpx 0; }.identity-badge { font-size: 18rpx; color: #8b9a87; }.switch-role { font-size: 22rpx; color: #176b5b; padding: 10rpx; flex-shrink: 0; }.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin: 26rpx 0; }.stats-grid view { text-align: center; padding: 21rpx 8rpx; }.stat-number { display: block; font-size: 47rpx; font-weight: 600; color: #345c45; line-height: 1.4; }.stat-label { font-size: 21rpx; color: #92a08f; }.menu { padding: 0 26rpx; }.menu-item { text-align: left; display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; border-bottom: 1rpx solid #edf0ed; border-radius: 0; font-size: 27rpx; }.menu-item:last-child { border: none; }.menu-item .muted { font-size: 21rpx; margin-top: 5rpx; }.menu-right { font-size: 22rpx; color: #8a9c8c; }.audit-row { margin-top: 19rpx; padding-bottom: 19rpx; border-bottom: 1rpx solid #eff2ef; }.audit-row:first-child { margin-top: 0; }.audit-row:last-child { border-bottom: 0; padding-bottom: 0; }.audit-title { font-size: 26rpx; color: #4b7056; }.audit-time { font-size: 19rpx; color: #a0ac9d; margin-top: 7rpx; }
