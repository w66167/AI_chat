/* 我的：白卡 + 蓝色强调，与首页/问答页同一套变量 */
.identity { display: flex; align-items: center; gap: 20rpx; margin-top: 28rpx; }
.avatar {
  width: 84rpx; height: 84rpx; line-height: 84rpx; flex: none;
  border-radius: 26rpx; background: var(--primary-soft); color: var(--primary-ink);
  text-align: center; font-size: 34rpx; font-weight: 650;
}
.identity-info { flex: 1; min-width: 0; }
.identity-name { font-size: 30rpx; font-weight: 650; }
.identity-info .muted { font-size: 21rpx; margin: 4rpx 0; }
.identity-badge { font-size: 19rpx; color: var(--muted); }
.switch-role {
  flex: none; font-size: 23rpx; color: var(--primary); padding: 10rpx 16rpx;
  background: var(--primary-soft); border-radius: 100rpx;
}

.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin: 24rpx 0; }
.stats-grid view { text-align: center; padding: 20rpx 8rpx; }
.stat-number { display: block; font-size: 46rpx; font-weight: 700; color: var(--text); line-height: 1.35; }
.stat-label { font-size: 21rpx; color: var(--muted); }

.menu { padding: 0 26rpx; }
.menu-item {
  display: flex; align-items: center; justify-content: space-between;
  text-align: left; padding: 26rpx 0; border-radius: 0;
  border-bottom: 1rpx solid var(--line); font-size: 27rpx;
}
.menu-item:last-child { border-bottom: none; }
.menu-item .muted { font-size: 21rpx; margin-top: 4rpx; }
.menu-right { font-size: 22rpx; color: var(--muted); flex: none; margin-left: 16rpx; }

.audit-row { padding-bottom: 18rpx; margin-bottom: 18rpx; border-bottom: 1rpx solid var(--line); }
.audit-row:last-child { border-bottom: none; padding-bottom: 0; margin-bottom: 0; }
.audit-title { font-size: 26rpx; color: var(--text); }
.audit-time { font-size: 20rpx; color: #a3aab8; margin-top: 6rpx; }
