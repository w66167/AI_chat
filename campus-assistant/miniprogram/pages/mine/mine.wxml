<view class="page">
  <view class="notice" wx:if="{{offline}}">
    <view>连不上服务，下面显示的是上次的身份信息。{{offlineReason}}</view>
    <view class="notice-action" bindtap="retry">重新连接</view>
  </view>

  <view class="me">
    <view class="me-avatar">{{role.avatar}}</view>
    <view class="me-main">
      <view class="me-name">{{role.name}}</view>
      <view class="me-desc">{{role.description}}</view>
    </view>
  </view>
  <view class="me-note" wx:if="{{devMode}}">当前是开发模式登录：服务端没有配置小程序 AppID，按设备发放的本地账号。</view>
  <view class="me-note" wx:elif="{{!isGuest}}">身份为自行声明，尚未经学校统一身份认证核验。</view>

  <view class="section">
    <view class="section-head"><text class="section-title">{{isGuest ? '绑定在校身份' : '更换身份'}}</text></view>
    <view class="panel">
      <button class="row" wx:for="{{options}}" wx:key="id" data-identity="{{item.identityType}}" disabled="{{binding}}" bindtap="choose">
        <view class="row-main">
          <view class="row-title">{{item.identityType === 'guest' ? '解除身份，回到游客' : '我是' + item.name}}</view>
          <view class="row-desc">{{item.description}}</view>
        </view>
        <view class="chevron"></view>
      </button>
    </view>
    <view class="code panel" wx:if="{{codeFor}}">
      <view class="code-label">绑定教师、行政人员身份需要口令，请向管理员获取。</view>
      <input class="code-input" value="{{code}}" placeholder="输入口令" password="{{true}}" maxlength="32" bindinput="codeChange" bindconfirm="submitCode"/>
      <view class="code-actions">
        <button class="btn btn-plain" bindtap="cancelCode">取消</button>
        <button class="btn btn-primary" disabled="{{binding}}" bindtap="submitCode">确认绑定</button>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head"><text class="section-title">我能查什么</text></view>
    <view class="panel">
      <view class="row library" wx:for="{{libraries}}" wx:key="id">
        <view class="row-main">
          <view class="library-head">
            <text class="row-title">{{item.name}}</text>
            <text class="chip {{item.accessible ? '' : 'chip-gray'}}" wx:if="{{item.content_status === 'ready'}}">{{item.accessible ? '可查' : '需相应身份'}}</text>
            <text class="chip chip-warn" wx:else>内容待补</text>
          </view>
          <view class="row-desc">{{item.summary}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="panel">
      <button class="row" bindtap="openHistory">
        <view class="row-main"><view class="row-title">提问记录</view><view class="row-desc">{{isGuest ? '绑定在校身份后保存' : '保存在服务端，换手机也能看'}}</view></view>
        <view class="chevron"></view>
      </button>
      <button class="row" bindtap="about">
        <view class="row-main"><view class="row-title">关于校园知答</view></view>
        <view class="chevron"></view>
      </button>
      <button class="row" wx:if="{{signedIn}}" bindtap="signOut">
        <view class="row-main"><view class="row-title sign-out">退出登录</view></view>
      </button>
    </view>
  </view>
</view>
