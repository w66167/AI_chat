.home { padding: 24rpx 28rpx 48rpx; }

/* ---------- 顶部 ---------- */
.hero { padding: 16rpx 4rpx 0; }
.hero-top { display: flex; align-items: center; justify-content: space-between; }
.brand { font-size: 24rpx; font-weight: 650; letter-spacing: 2rpx; color: var(--muted); }
.status {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 21rpx; padding: 6rpx 16rpx 6rpx 12rpx;
  border-radius: 100rpx; background: #f1f3f7; color: var(--muted);
}
.status .dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #b6bdc9; }
.status.on { background: #eaf1ff; color: var(--primary-ink); }
.status.on .dot { background: var(--primary); }
.hero-title {
  display: block; font-size: 52rpx; font-weight: 700;
  letter-spacing: -1rpx; line-height: 1.25; margin: 26rpx 0 10rpx;
}
.hero-sub { display: block; font-size: 25rpx; color: var(--muted); }

/* ---------- 提问框 ---------- */
.ask-box {
  display: flex; align-items: center; gap: 12rpx;
  background: #fff; border: 1rpx solid var(--line);
  border-radius: 100rpx; padding: 10rpx 10rpx 10rpx 30rpx;
  margin: 32rpx 0 8rpx;
}
.ask-input { flex: 1; font-size: 28rpx; height: 68rpx; }
.ask-btn {
  width: 96rpx; height: 68rpx; line-height: 68rpx;
  border-radius: 100rpx; background: var(--primary); color: #fff;
  font-size: 26rpx; font-weight: 600; text-align: center; flex: none;
}

/* ---------- 常问 ---------- */
.chips { display: flex; flex-wrap: wrap; }

/* ---------- 事项入口 ---------- */
.entries { display: flex; flex-wrap: wrap; gap: 18rpx; }
.entry {
  width: calc(50% - 9rpx); background: #fff; border: 1rpx solid var(--line);
  border-radius: var(--radius); padding: 24rpx; text-align: left;
  display: flex; flex-direction: column; gap: 16rpx;
}
.entry:active { background: #fafbff; border-color: #dfe7ff; }
.entry-mark {
  width: 64rpx; height: 64rpx; border-radius: 18rpx;
  font-size: 28rpx; font-weight: 650; color: #fff;
  display: flex; align-items: center; justify-content: center;
}
.entry-mark.blue { background: #2b6ef2; }
.entry-mark.violet { background: #7c5cf0; }
.entry-mark.amber { background: #d99442; }
.entry-mark.green { background: #22a06b; }
.entry-text { display: flex; flex-direction: column; gap: 4rpx; }
.entry-label { font-size: 28rpx; font-weight: 600; }
.entry-desc { font-size: 22rpx; color: var(--muted); }

/* ---------- 底部 ---------- */
.foot { margin-top: 44rpx; display: flex; flex-direction: column; gap: 6rpx; }
.foot text { font-size: 22rpx; color: var(--muted); }
.foot-dim { color: #a3aab8; }
