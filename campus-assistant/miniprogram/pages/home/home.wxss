.ask-block { background: var(--green); color: #fff; padding: 36rpx 32rpx 44rpx; }
.ask-who { font-size: 23rpx; color: #b9d6cc; }
.ask-title { font-family: var(--serif); font-size: 50rpx; line-height: 1.4; font-weight: 700; margin: 20rpx 0 36rpx; }
.ask-box { display: flex; align-items: center; background: #fff; border-radius: 18rpx; padding: 10rpx 10rpx 10rpx 28rpx; }
.ask-input { flex: 1; height: 80rpx; font-size: 29rpx; color: var(--ink); }
.ask-placeholder { color: var(--ink-3); }
.ask-send { background: var(--green); color: #fff; padding: 16rpx 34rpx; border-radius: 12rpx; font-size: 27rpx; font-weight: 600; }
.ask-foot { font-size: 22rpx; color: #b9d6cc; margin-top: 22rpx; }

.home-body { padding-top: 28rpx; }
.home-body .notice + .section { margin-top: 36rpx; }
.home-body .section:first-child { margin-top: 8rpx; }

.category-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.category { background: var(--card); border-radius: 18rpx; padding: 26rpx 28rpx; }
.category-name { font-size: 29rpx; font-weight: 600; }
.category-count { font-size: 23rpx; color: var(--ink-3); margin-top: 4rpx; }

.home-foot { text-align: center; font-size: 22rpx; color: var(--ink-3); margin-top: 48rpx; }
