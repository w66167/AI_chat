<view class="home">
  <view class="hero">
    <view class="hero-top">
      <text class="brand">校园知答</text>
      <view class="status {{online ? 'on' : 'off'}}">
        <view class="dot"></view>
        <text>{{online ? '在线' : '本地'}}</text>
      </view>
    </view>
    <text class="hero-title">问点校园里的事</text>
    <text class="hero-sub">答案来自《学生手册》，每条都带出处</text>
  </view>

  <view class="ask-box">
    <input class="ask-input" value="{{question}}" placeholder="比如：宿舍几点熄灯" confirm-type="send"
           bindinput="inputChange" bindconfirm="ask" />
    <button class="ask-btn" bindtap="ask" disabled="{{!question}}">问</button>
  </view>

  <view class="section-head">
    <text class="section-title">常问</text>
    <text class="section-link" bindtap="openServices">办事指南 ›</text>
  </view>
  <view class="chips">
    <button class="chip" wx:for="{{hot}}" wx:key="*this" data-question="{{item}}" bindtap="ask">{{item}}</button>
  </view>

  <view class="section-head"><text class="section-title">按事项找</text></view>
  <view class="entries">
    <button class="entry" wx:for="{{entries}}" wx:key="label" data-question="{{item.question}}" bindtap="ask">
      <view class="entry-mark {{item.color}}">{{item.mark}}</view>
      <view class="entry-text">
        <text class="entry-label">{{item.label}}</text>
        <text class="entry-desc">{{item.desc}}</text>
      </view>
    </button>
  </view>

  <view class="foot">
    <text>{{online ? '已接入学生手册 2017 版 · ' + knowledgeCount + ' 条知识' : '本地演示 · ' + knowledgeCount + ' 条示例'}}</text>
    <text class="foot-dim">仅供信息查询，不代为办理 · 请勿输入证件号等个人信息</text>
  </view>
</view>
