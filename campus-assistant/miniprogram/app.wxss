/* 全局样式。颜色和字体只在这里定义，页面里一律用变量。
   --green 是操作色（按钮、链接、选中）；--seal 只给条号用，取自红头文件的朱红。 */
page {
  --paper: #f4f6f3;
  --card: #ffffff;
  --ink: #1b2a26;
  --ink-2: #5c6b66;
  --ink-3: #93a09b;
  --line: #e3e8e4;
  --green: #176b5b;
  --green-soft: #e4efe9;
  --seal: #b4432f;
  --warn-bg: #fbf3e2;
  --warn-ink: #8a6420;
  --serif: 'Songti SC', 'STSong', 'Noto Serif CJK SC', 'Source Han Serif SC', serif;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
view, text, button, input, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0; font-size: 28rpx; line-height: 1.6; border-radius: 0; background: transparent; color: inherit; text-align: left; font-weight: 400; }
button::after { border: none; }
button[disabled] { opacity: .45; }

.page { padding: 32rpx 32rpx 64rpx; }
.page-title { font-size: 44rpx; line-height: 1.35; font-weight: 700; }
.page-sub { color: var(--ink-2); font-size: 25rpx; margin-top: 10rpx; }
.section { margin-top: 48rpx; }
.section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18rpx; }
.section-title { font-size: 30rpx; font-weight: 600; }
.section-more { font-size: 24rpx; color: var(--green); padding: 6rpx 0 6rpx 20rpx; }
.muted { color: var(--ink-3); font-size: 24rpx; }

/* 面板：一组相关内容的白底容器。行与行之间用细线分隔，不是每行一张卡片。 */
.panel { background: var(--card); border-radius: 20rpx; overflow: hidden; }
.row { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; border-bottom: 1rpx solid var(--line); width: 100%; }
.row:last-child { border-bottom: 0; }
.row-main { flex: 1; min-width: 0; }
.row-title { font-size: 28rpx; }
.row-desc { color: var(--ink-3); font-size: 23rpx; margin-top: 4rpx; }
.chevron { width: 14rpx; height: 14rpx; border-top: 3rpx solid var(--ink-3); border-right: 3rpx solid var(--ink-3); transform: rotate(45deg); flex-shrink: 0; }

/* 条文签：全小程序唯一的引用样式。问答的出处、搜索结果、文件目录、提问记录都用它。
   左边一道朱红竖线，宋体条号，右边页码——对应手册里「哪份文件、哪一条、哪一页」。 */
.slip { display: flex; align-items: flex-start; gap: 20rpx; width: 100%; padding: 22rpx 24rpx 22rpx 20rpx; border-left: 6rpx solid var(--seal); background: var(--card); }
.slip + .slip { margin-top: 12rpx; }
.slip-main { flex: 1; min-width: 0; }
.slip-article { font-family: var(--serif); font-size: 29rpx; font-weight: 700; color: var(--seal); line-height: 1.4; }
.slip-doc { font-size: 23rpx; color: var(--ink-2); margin-top: 4rpx; }
.slip-text { font-size: 25rpx; color: var(--ink-2); margin-top: 8rpx; line-height: 1.7; }
.slip-page { font-size: 22rpx; color: var(--ink-3); flex-shrink: 0; padding-top: 6rpx; }

.btn { display: block; text-align: center; padding: 24rpx 28rpx; border-radius: 14rpx; font-size: 28rpx; font-weight: 600; }
.btn-primary { background: var(--green); color: #fff; }
.btn-ghost { background: var(--green-soft); color: var(--green); }
.btn-plain { color: var(--ink-2); font-weight: 400; }

.chip { display: inline-block; padding: 6rpx 18rpx; border-radius: 100rpx; font-size: 22rpx; background: var(--green-soft); color: var(--green); }
.chip-gray { background: #eceeed; color: var(--ink-2); }
.chip-warn { background: var(--warn-bg); color: var(--warn-ink); }

.notice { padding: 22rpx 26rpx; border-radius: 16rpx; font-size: 24rpx; line-height: 1.7; background: var(--warn-bg); color: var(--warn-ink); }
.notice-action { color: var(--green); font-weight: 600; margin-top: 10rpx; display: inline-block; padding: 4rpx 0; }

/* 状态页：加载中 / 连不上 / 空。说清楚发生了什么、接下来能做什么。 */
.state { text-align: center; padding: 120rpx 48rpx; color: var(--ink-2); }
.state-title { font-size: 30rpx; color: var(--ink); font-weight: 600; margin-bottom: 12rpx; }
.state-desc { font-size: 25rpx; line-height: 1.8; }
.state .btn { display: inline-block; margin-top: 36rpx; padding: 18rpx 48rpx; }

.search { display: flex; align-items: center; gap: 16rpx; background: var(--card); border-radius: 16rpx; padding: 0 24rpx; height: 88rpx; }
.search input { flex: 1; height: 88rpx; font-size: 28rpx; }
.search-clear { color: var(--ink-3); font-size: 24rpx; padding: 12rpx 0 12rpx 16rpx; }
